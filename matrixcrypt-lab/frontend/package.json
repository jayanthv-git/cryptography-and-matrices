{
  "name": "matrixcrypt-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "types:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api-schema.d.ts",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
